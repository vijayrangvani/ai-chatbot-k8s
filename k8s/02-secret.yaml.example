# Copy to 02-secret.yaml and fill in real values. 02-secret.yaml is gitignored.
apiVersion: v1
kind: Secret
metadata:
  name: ai-chatbot-secret
  namespace: ai-chatbot
type: Opaque
stringData:                 # plain text; K8s base64-encodes it (base64 is NOT encryption)
  DATABASE_URL: "postgresql+psycopg://app:app@db:5432/chatdb"
  POSTGRES_PASSWORD: CHANGE_ME  # must match the password in DATABASE_URL
